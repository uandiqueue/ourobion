#!/bin/sh
# Shared pre-push hook (enabled via `git config core.hooksPath .githooks`).
#
# CI re-runs the context check. graphify-out/ is intentionally machine-local, so CI cannot regenerate
# the semantic graph; when that graph exists locally, this hook also requires its one tracked human
# view to match.
set -e

echo "[pre-push] context_sync --check (sessions / memory / decisions / index / couplings)"
node tools/context_sync.mjs --check

echo "[pre-push] graph-view --check (single tracked view; compare local graph when present)"
node tools/graph-view/generate_graph_view.mjs --check

echo "[pre-push] ok"
