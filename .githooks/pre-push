#!/bin/sh
# Shared pre-push hook (enabled via `git config core.hooksPath .githooks`).
#
# Enforces in-repo context accuracy before a push. Local hooks are skippable with --no-verify, so CI
# (.github/workflows/ci.yml) re-runs the same check (plus flutter analyze + flutter test) as the
# non-bypassable backstop.
#
# Git (esp. Git for Windows) runs hooks under `sh`. To stay portable this depends ONLY on `node` and
# `git` being on PATH (both are real executables `sh` can resolve). ourobion's structural dependency
# graph is DEFERRED (see docs/graph/README.md), so — unlike NUSPlan's hook — there is no graph
# regenerate+diff step here yet. When a generated graph is added, regenerate + diff it below.
set -e

echo "[pre-push] context_sync --check (sessions / memory / couplings)"
node tools/context_sync.mjs --check

echo "[pre-push] ok"
