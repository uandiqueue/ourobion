{
  "version": 1,
  "nodes": {
    "seeder": { "model": "gpt-5-mini", "route": "api_worker", "maxOutputTokens": 8000 },
    "synthesis": { "model": "gpt-5", "route": "api_worker", "maxOutputTokens": 8000 },
    "verifier": { "model": "claude-sonnet-5", "route": "api_worker", "maxOutputTokens": 8000 },
    "phrasing_card": { "model": "gpt-5-mini", "route": "api_worker", "maxOutputTokens": 2000 },
    "report_narrative": { "model": "gpt-5-mini", "route": "api_worker", "maxOutputTokens": 4000 },
    "extract_assist": { "model": "gpt-5-mini", "route": "api_worker", "maxOutputTokens": 2000 }
  },
  "providers": [
    { "prefix": "claude-", "family": "anthropic", "envKey": "ANTHROPIC_API_KEY" },
    { "prefix": "gpt-", "family": "openai", "envKey": "OPENAI_API_KEY" },
    { "prefix": "o3", "family": "openai", "envKey": "OPENAI_API_KEY" },
    { "prefix": "o4", "family": "openai", "envKey": "OPENAI_API_KEY" },
    { "prefix": "gemini-", "family": "google", "envKey": "GOOGLE_API_KEY" },
    { "prefix": "agnes-", "family": "agnes", "envKey": "AGNES_API_KEY" }
  ],
  "prices": {
    "claude-sonnet-5": { "inputUsdPerMTok": 3.0, "outputUsdPerMTok": 15.0, "provisional": true },
    "claude-haiku-4-5": { "inputUsdPerMTok": 1.0, "outputUsdPerMTok": 5.0, "provisional": true },
    "gpt-5": { "inputUsdPerMTok": 1.25, "outputUsdPerMTok": 10.0, "provisional": true },
    "gpt-5-mini": { "inputUsdPerMTok": 0.25, "outputUsdPerMTok": 2.0, "provisional": true }
  },
  "budget": {
    "perRunOutputTokens": 60000,
    "perDayUsdPerNode": 1.0,
    "hardStopFraction": 0.95,
    "ledgerPath": "data/llm-router/ledger.json",
    "retentionDays": 30
  },
  "localAgent": {
    "mailboxDir": "data/llm-router/mailbox",
    "timeoutMs": 300000,
    "pollIntervalMs": 500
  },
  "acceptance": {
    "journalPath": "data/llm-router/acceptance-attempts.jsonl"
  }
}
