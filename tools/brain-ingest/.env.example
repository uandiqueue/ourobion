# Brain ingestion (paper corpus) — backend secrets template
# See docs/nao/BRAIN-INGESTION-DESIGN.md for what each source does.
#
# Legend:  [REQUIRED] pipeline can't run without it · [RECOMMENDED] free, lifts rate limits ·
#          [OPTIONAL] only if you opt into that source.

# ─────────────────────────────────────────────────────────────────────────────
# Contact (polite pools) — [REQUIRED]
# Sent as the mailto= / email= param to Crossref, OpenAlex, and Unpaywall so they
# put us in the faster "polite pool" instead of throttling anonymous traffic.
# ─────────────────────────────────────────────────────────────────────────────
INGEST_CONTACT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Discovery / OA-location keys
# ─────────────────────────────────────────────────────────────────────────────
# [REQUIRED] OpenAlex — the OA-location backbone (resolves best_oa_location for every
# fetch). 2026: key required; $1/day free usage. We batch DOIs into list calls ($0.0001 ea),
# so the whole 2000-paper corpus costs ~$0.004 — nowhere near the cap. Get it at:
# https://openalex.org  (account → openalex.org/settings/api)
OPENALEX_API_KEY=

# [RECOMMENDED] NCBI / PubMed E-utilities — lifts PubMed from 3 req/s to 10 req/s.
# Get it at: https://www.ncbi.nlm.nih.gov  (account → Settings → API Key Management)
NCBI_API_KEY=

# [RECOMMENDED] Semantic Scholar (S2AG) — raises the shared anonymous rate limit.
# Get it at: https://www.semanticscholar.org/product/api  (request a key)
S2_API_KEY=

# [RECOMMENDED] CORE — needed for sustained full-text PDF downloads (else rate-limited).
# Get it at: https://core.ac.uk/services/api  (register)
CORE_API_KEY=

# [OPTIONAL] Lens.org — scholarly + patent metadata; quota-limited, verify before relying.
# Get it at: https://www.lens.org  (register → API token)
LENS_API_KEY=

# Keyless sources need no entry here: Crossref, DOAJ, Unpaywall, PMC OA Subset,
# Europe PMC, arXiv, bioRxiv/medRxiv.

# ─────────────────────────────────────────────────────────────────────────────
# Storage — Cloudflare R2 (S3-compatible), the durable corpus store — [REQUIRED]
# Order matters: create the bucket FIRST, then mint a token scoped to it.
#   1. dash.cloudflare.com → R2 → create bucket  ourobion-corpus
#   2. R2 → Manage R2 API Tokens → Create token
#        Permission: "Object Read & Write"  (NOT Admin — least privilege)
#        Scope:      Apply to specific buckets only → ourobion-corpus
# The token can read/write objects but cannot create/delete buckets, which is all
# the pipeline does (PutObject / GetObject / HeadObject / ListObjects).
# ─────────────────────────────────────────────────────────────────────────────
# Note: the standalone "Token value" Cloudflare shows is for its native REST API
# (Bearer auth) and is NOT used here — we talk S3, which uses the key ID + secret below.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ourobion-corpus
