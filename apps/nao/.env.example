# ourobion nao — server SECRETS template (backend-only; never client-visible)
# Copy to apps/nao/.env and fill in:
#   cp apps/nao/.env.example apps/nao/.env
#
# Repo convention (see docs/shared/structure-context.md "Environment Files"):
#   .env         = secrets (this file)            ← never bundled/exposed
#   .env.public  = client-visible config          ← see .env.public.example
# Cloudflare bindings (R2, D1) are NOT env — they live in wrangler.jsonc.
# wrangler's local-runtime secrets file `.dev.vars` is generated from this .env by a predev
# step and is gitignored — you only ever edit .env / .env.public.

# ── Supabase (ourobion-nao project) — server-only ─────────────────────────────
# Access tokens are verified at the edge via the project's JWKS (ES256) — no JWT secret needed.
# SUPABASE_URL is not duplicated here: gen-env mirrors NEXT_PUBLIC_SUPABASE_URL into .dev.vars.
# The deployed Worker receives SUPABASE_URL as a runtime value declared in wrangler.jsonc.

# Replacement publishable API key for the server-to-server run-pipeline call. In hosted Edge
# Functions Supabase supplies SUPABASE_PUBLISHABLE_KEYS as JSON (for example
# {"default":"sb_publishable_..."}); this singular form is for a one-key Worker runtime.
# It is safe to expose as an API key, but never send it in Authorization: Bearer.
SUPABASE_PUBLISHABLE_KEY=

# The internal-secret protocol's SENDER-side value (R4-U2): apps/nao/src/app/(app)/api/loader/
# run-pipeline/route.ts sends this as the `X-Ourobion-Internal-Secret` header to the
# run-pipeline edge function — it is the ONLY authorization input that function checks. Must
# match one of the edge functions' OUROBION_INTERNAL_SECRET_CURRENT / _PREVIOUS rotation pair
# (supabase/functions/_shared/internal_auth.ts). Server-only: NEVER NEXT_PUBLIC_-prefixed, never
# sent to the browser. 32 random bytes, base64url (43 chars, `^[A-Za-z0-9_-]{43}$`). Leave empty
# here — never commit a real or realistic-looking value.
OUROBION_INTERNAL_SECRET=

# Fine-grained PAT scoped to this repository with Actions: Read and write.
# GH_REPO and GH_ACTIONS_REF are ordinary committed vars in wrangler.jsonc.
GH_ACTIONS_TOKEN=

# ── Cloudflare R2 (ourobion-corpus) — local/CI D1 ETL only ────────────────────
# The deployed Worker reads R2 via a native binding (wrangler.jsonc). These S3 creds are ONLY
# for the off-Workers ETL (manifest → D1); reuse the values in tools/brain-ingest/.env:
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ourobion-corpus
