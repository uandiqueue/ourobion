# ourobion nao — environment template
# Copy to apps/nao/.dev.vars (Cloudflare Workers' local-secrets file) for local dev:
#   cp apps/nao/.env.example apps/nao/.dev.vars
#
# IMPORTANT — Cloudflare bindings vs env:
#   On the deployed Worker, R2 and D1 are wired as BINDINGS in wrangler.jsonc, NOT here —
#   so NO R2/D1 credentials live in env. Only Supabase config (+ optional R2 S3 creds for the
#   local/CI D1 ETL that runs off-Workers) belong in this file.

# ── Supabase — the `ourobion-nao` project (auth only for v1) ──────────────────
# Project URL + publishable/anon key from the ourobion-nao project → Settings → API.
SUPABASE_URL=https://<ourobion-nao-ref>.supabase.co
SUPABASE_ANON_KEY=
# Access tokens are verified at the edge via the project's JWKS (asymmetric ES256) — no JWT
# secret needed. Service-role key only if a server route must bypass RLS (NOT needed for v1):
# SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (ourobion-corpus) ───────────────────────────────────────────
# The deployed Worker reads R2 via a NATIVE BINDING declared in wrangler.jsonc:
#   "r2_buckets": [{ "binding": "CORPUS", "bucket_name": "ourobion-corpus" }]
# The values below are ONLY for the local/CI D1 ETL (manifest → D1), which runs off-Workers.
# Reuse the same values you put in tools/brain-ingest/.env:
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ourobion-corpus

# ── Cloudflare D1 (derived search index) ──────────────────────────────────────
# Create with:  wrangler d1 create ourobion-nao-index
# Then wire it as a BINDING in wrangler.jsonc (NOT here):
#   "d1_databases": [{ "binding": "DB", "database_name": "ourobion-nao-index", "database_id": "<id>" }]

# ── app ───────────────────────────────────────────────────────────────────────
APP_ENV=development
