# ourobion nao — PUBLIC client config template (client-visible; safe to ship to the browser)
# Copy to apps/nao/.env.public and fill in:
#   cp apps/nao/.env.public.example apps/nao/.env.public
#
# Mirrors apps/biotope/.env.public: client-visible values ONLY. Secrets go in .env (see .env.example).
# Next.js requires the NEXT_PUBLIC_ prefix to expose a var to the browser.

# Supabase (ourobion-nao project) → Settings → API. The anon/publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<ourobion-nao-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_ENV=development
