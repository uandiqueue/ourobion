# Ourobion Flutter public client config template
# Copy this file to .env.public and fill in your local values:
#   cp .env.public.example .env.public
#
# Values in this file are client-facing. Do not put backend secrets here.
# Good: SUPABASE_URL, SUPABASE_ANON_KEY, APP_ENV
# Bad: SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY, DATABASE_PASSWORD

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
